# Supabase configuration — committed template, PLACEHOLDERS ONLY (never real keys).
#
# SECURITY: Only NEXT_PUBLIC_* vars are exposed to the browser bundle.
# The service-role vars below (SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY) MUST NOT
# use the NEXT_PUBLIC_ prefix — that would leak the service-role key to the client
# and bypass Row Level Security. Keep them server-only.

# --- Public (browser-safe, RLS-enforced anon client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only (service-role client; bypasses RLS — never expose) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
